# URL pública del sitio (sin barra final)
NEXT_PUBLIC_SITE_URL=https://asoproyuja.org

# WordPress headless. Déjalo vacío para publicar con el contenido local (carpeta /content).
# Ejemplo: https://cms.asoproyuja.org
WP_URL=

# Secreto compartido con el plugin "Asoproyuja Headless" (wp-config.php → ASOPROYUJA_REVALIDATE_SECRET)
# Lo usa WordPress para avisarle a Vercel que publique cambios al instante.
REVALIDATE_SECRET=

# Secreto compartido para que el formulario de contacto y el newsletter guarden los datos en WordPress
# (wp-config.php → ASOPROYUJA_FORM_SECRET)
FORM_SECRET=
